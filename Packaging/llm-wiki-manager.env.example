# Required. Use an absolute path.
LLM_WIKI_VAULT=/srv/llm-wiki

# claude, codex, or pi
LLM_WIKI_AGENT=pi

# Pi's default model requires: pi install npm:pi-cliproxyapi-provider
# Optional overrides. Empty values use the agent CLI defaults.
LLM_WIKI_BINARY=
LLM_WIKI_MODEL=cpa/gpt-5.6-sol
LLM_WIKI_REASONING_EFFORT=high
LLM_WIKI_INGEST_DEPTH=normal
# Optional: acceptEdits for Claude, workspace-write for Codex, or full-access for Pi.
# LLM_WIKI_PERMISSION_MODE=workspace-write
LLM_WIKI_POLL_INTERVAL=5
LLM_WIKI_MAX_RETRIES=3
LLM_WIKI_RETRY_BACKOFF=10
