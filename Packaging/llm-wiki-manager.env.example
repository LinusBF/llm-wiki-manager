# Required. Use an absolute path.
LLM_WIKI_VAULT=/srv/llm-wiki

# claude or codex
LLM_WIKI_AGENT=codex

# Optional overrides. Empty values use the agent CLI defaults.
LLM_WIKI_BINARY=
LLM_WIKI_MODEL=
LLM_WIKI_REASONING_EFFORT=system-default
LLM_WIKI_INGEST_DEPTH=normal
# Optional: acceptEdits for Claude or workspace-write for Codex.
# LLM_WIKI_PERMISSION_MODE=workspace-write
LLM_WIKI_POLL_INTERVAL=5
LLM_WIKI_MAX_RETRIES=3
LLM_WIKI_RETRY_BACKOFF=10
